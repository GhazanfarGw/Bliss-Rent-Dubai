# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real credentials.

# ---------------------------------------------------------------------------
# PUBLIC — safe to expose to the browser (Vite only exposes VITE_* vars to
# client code in the first place). Access control is enforced by Supabase
# Row Level Security, not by keeping these secret.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Newer Supabase projects call this the "publishable key" instead of
# "anon key" in the dashboard — same thing, put it here either way.
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ---------------------------------------------------------------------------
# SERVER-SIDE ONLY — for Supabase Edge Functions (supabase/functions/*),
# never for the frontend. Do NOT prefix these with VITE_, and never import
# them from anything under src/. In production these are set as Supabase
# Function secrets (`supabase secrets set ...`), not read from this file.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-KEEP-SECRET

# Payment gateway secret keys, when chosen in a later phase, also belong in
# this server-side-only section — never as a VITE_ variable.
